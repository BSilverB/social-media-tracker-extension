  // 8. KẾT QUẢ PHẢN TƯ CUỐI NGÀY
  "reflection": {
    "lesson1": "",
    "lesson2": "",
    "rating": 5,
    "aiFeedback": "",
    "submittedAt": null           // Timestamp nộp bài lúc 22h00[cite: 2, 3]
  },
  "petEnergyEndOfDay": 100        // Năng lượng thú cưng chốt sổ lúc 23h59[cite: 2, 3]
}

