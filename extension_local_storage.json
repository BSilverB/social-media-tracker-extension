1. Key Dữ liệu Thống kê theo Ngày: "stats_YYYY-MM-DD" (ví dụ: "stats_2026-10-08")
{
  "date": "2026-10-08",

  // 1. NỀN TẢNG YOUTUBE (Nằm trực tiếp ở root)
  "youtube": {
    "summary": {
      "activeSeconds": 0,         // Thời gian tab YouTube active và có tương tác (giây)[cite: 2, 4]
      "passiveSeconds": 0,        // Thời gian phát nền/không tương tác[cite: 2, 4]
      "reloadCount": 0            // Số lần ấn F5 hoặc click Logo YouTube[cite: 2, 4]
    },
    "shorts": {
      "totalSwipes": 0,           // Tổng số lần quẹt Shorts[cite: 2, 3]
      "validViews": 0,            // Số Shorts dừng xem >= 2s[cite: 1, 3]
      "impulsiveCount": 0,        // Số Shorts lướt qua < 2s (lướt bốc đồng)[cite: 1, 3]
      "loopViews": 0              // Số lần xem lặp lại video ngắn[cite: 1, 3]
    },
    "longVideos": {
      "totalWatched": 0,          // Tổng số video dài (/watch) đã click mở[cite: 2, 3]
      "usefulCount": 0,           // Số video xem >= 80% thời lượng (hoặc >= 3 phút)[cite: 1, 4]
      "impulsiveCount": 0         // Số video xem < 15% thời lượng rồi tắt ngang[cite: 1, 4]
    },
    "musicVideos": {              // Video nghe nhạc trong phiên Pomodoro (không tính vào longVideos)[cite: 2, 3]
      "totalWatched": 0,
      "durationSeconds": 0
    }
  },

  // 2. NỀN TẢNG FACEBOOK (Nằm trực tiếp ở root)
