    "summary": {
      "activeSeconds": 0,
      "passiveSeconds": 0,
      "reloadCount": 0
    },
    "feed": {
      "feedPostsScrolled": 0,     // Số bài viết bảng tin đã cuộn qua[cite: 2, 3]
      "feedPostsRead": 0          // Số bài viết dừng đọc sâu
    },
    "reels": {
      "totalSwipes": 0,           // Tổng số lần quẹt Reels[cite: 2, 3]
      "validViews": 0,            // Dừng xem >= 2s[cite: 1, 3]
      "impulsiveCount": 0,
      "loopViews": 0
    },
    "longVideos": {
      "totalWatched": 0,          // Facebook Watch (/watch)[cite: 2, 3]
      "usefulCount": 0,
      "impulsiveCount": 0
    }
  },

  // 3. NỀN TẢNG TIKTOK (Nằm trực tiếp ở root)
  "tiktok": {
    "summary": {
      "activeSeconds": 0,
      "passiveSeconds": 0,
      "reloadCount": 0
    },
    "shorts": {
      "totalSwipes": 0,
      "validViews": 0,
      "impulsiveCount": 0,
      "loopViews": 0
    }
  },

  // 4. PHÂN BỔ 24 BUCKETS THEO GIỜ (Tổng hợp toàn bộ hành vi)
  "hourly": [
    // Mảng 24 phần tử (tương ứng từ hour 0 đến hour 23)
    {
      "hour": 0,
      "swipes": 0,                // Gộp tất cả Shorts + Reels + TikTok[cite: 2, 3, 4]
      "longVideos": 0,            // Gộp tất cả video dài[cite: 2, 3]
      "feedScrolled": 0,          // Bài viết Facebook Feed[cite: 2, 3]
      "reloads": 0,               // F5 / Refresh[cite: 2, 3, 4]
      "activeSeconds": 0          // Thời gian hoạt động thực tế[cite: 2, 3]
    }
  ],

  // 5. CHỈ SỐ VƯỢT QUA CÁM DỖ (Box Breathing 12s)
  "temptation": {
    "resistedCount": 0,           // Thở xong và quyết định tắt tab (vượt qua cám dỗ)[cite: 1, 2, 3]
    "succumbedCount": 0           // Thở xong nhưng bấm xem tiếp 5 lượt (chịu thua cám dỗ)[cite: 2, 3]
  },

  // 6. NHẬT KÝ VIDEO TRONG NGÀY (Làm nguyên liệu phản tư 22h00)
